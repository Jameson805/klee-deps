array N[8] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 (Select w64 N0:(Slt N1:(ReadLSB w64 0 N)
                                     0)
                             (Sub w64 0 N1)
                             N1)))
         (Sle (Select w32 N0 4294967295 1) 0)]
        false)
