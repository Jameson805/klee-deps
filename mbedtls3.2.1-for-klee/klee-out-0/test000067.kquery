array N[8] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 N0:(Select w64 N1:(Slt N2:(ReadLSB w64 0 N)
                                        0)
                                (Sub w64 0 N2)
                                N2)))
         (Eq false
             (Sle (Select w32 N1 4294967295 1) 0))
         (Eq 0 (And w64 N0 1))]
        false)
