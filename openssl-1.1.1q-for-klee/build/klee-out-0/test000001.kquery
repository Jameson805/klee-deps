array base_buf[32] : w32 -> w8 = symbolic
array exp_buf[32] : w32 -> w8 = symbolic
array mod_buf[32] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 (Read w8 0 base_buf)))
         (Eq false
             (Eq 0 (Read w8 0 exp_buf)))
         (Eq false
             (Eq 0 (Read w8 0 mod_buf)))]
        false)
